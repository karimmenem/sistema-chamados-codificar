generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportPerson {
  id      Int      @id @default(autoincrement())
  name    String
  tickets Ticket[]
}

model Ticket {
  id           Int           @id @default(autoincrement())
  title        String
  description  String
  priority     Priority
  status       TicketStatus  @default(OPEN)
  assignedToId Int
  assignedTo   SupportPerson @relation(fields: [assignedToId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}